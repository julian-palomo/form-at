# Gitignored files Claude Code copies into every worktree it creates
# (`claude --worktree <name>` -> .claude/worktrees/<name>/). Same syntax as
# .gitignore; only files that are gitignored are copied. Secrets and personal
# settings only: node_modules is reinstalled with `pnpm install` there.
CLAUDE.local.md
.claude/settings.local.json
apps/web/.env
apps/web/.env.local
apps/admin/.env
apps/admin/.env.local
# Regenerated by `vite dev`/`vite build`, but `pnpm check` needs it on disk
# before either has run in the new worktree.
apps/*/app/routeTree.gen.ts
